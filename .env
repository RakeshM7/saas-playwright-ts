# Test Environment Variables for Dry Run

# ==================== APP URLS ====================
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api

# ==================== CREDENTIALS ====================
TEST_EMAIL=test@example.com
TEST_PASSWORD=password123

# ==================== BROWSER SETTINGS ====================
BROWSER=chromium
HEADLESS=true

# ==================== TIMEOUTS ====================
DEFAULT_TIMEOUT=30000
WAIT_TIMEOUT=5000

# ==================== LOGGING ====================
LOG_LEVEL=info

# ==================== EXECUTION ====================
ENVIRONMENT=dev
CI=false
WORKERS=4
SMOKE_WORKERS=1
