# Environment Variables Template
# Copy this file to .env.dev, .env.staging, or .env.production
# Fill in the actual values for your environment
# WARNING: Do NOT commit .env files to git - they contain secrets!

# ==================== APP URLS ====================
# The base URL of the application under test
# Example: https://dev.yourapp.com or https://staging.yourapp.com
BASE_URL=https://dev.yourapp.com

# The API endpoint URL
# Example: https://api-dev.yourapp.com or https://api-staging.yourapp.com
API_BASE_URL=https://api-dev.yourapp.com

# ==================== CREDENTIALS ====================
# Test user email for login tests
# Use a test account, never a real user account
TEST_EMAIL=test@example.com

# Test user password
# Keep this secure, use a test-only password
TEST_PASSWORD=password123

# ==================== BROWSER SETTINGS ====================
# Which browser to use for tests
# Options: chromium (default), firefox, webkit
BROWSER=chromium

# Run tests in headless mode (no visible browser window)
# Set to true for CI/CD, false for debugging
HEADLESS=true

# ==================== TIMEOUTS ====================
# Default timeout for test execution in milliseconds
# Example: 30000 = 30 seconds
# Increase this if tests are timing out unexpectedly
DEFAULT_TIMEOUT=30000

# Timeout for explicit waits in milliseconds
# Example: 5000 = 5 seconds
# Used for waiting for elements to appear
WAIT_TIMEOUT=5000


# ==================== LOGGING ====================
# Logging level for test output
# Options: debug (very verbose), info (normal), warn (warnings only), error (errors only)
# Use debug during development, info in CI/CD
LOG_LEVEL=info

# ==================== EXECUTION ====================
# Target environment for tests
# Options: dev (development), staging (staging), production (production)
# Set based on which environment you want to test against
ENVIRONMENT=dev

# Set to true when running in CI/CD (GitHub Actions, Jenkins)
# Set to false for local development
# Used to detect execution environment and adjust behavior
CI=false

# Number of parallel workers for test execution
# Example: 4 = 4 tests run in parallel
# Increase for faster execution, decrease for lower resource usage
WORKERS=4

# Number of workers specifically for smoke tests
# Should be lower than WORKERS for faster feedback
# Example: 1 = single worker (fast feedback on critical path)
SMOKE_WORKERS=1
